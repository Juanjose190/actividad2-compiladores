# ─────────────────────────────────────────────
# Base de datos PostgreSQL
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NOMBRE=cal_db
DB_USUARIO=cal_usuario
DB_CONTRASENA=cambiar_en_produccion

# ─────────────────────────────────────────────
# Backend NestJS
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# JWT — usar secreto largo y aleatorio en producción
JWT_SECRETO=cambiar_en_produccion_secreto_largo_minimo_32_chars
JWT_EXPIRACION=8h
JWT_EXPIRACION_REFRESH=7d

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Frontend Vite
# ─────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# IA — Gemini (Fase 4)
# ─────────────────────────────────────────────
# GEMINI_API_KEY=tu_clave_gemini_aqui
